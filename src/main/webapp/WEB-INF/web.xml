<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">
    <display-name>CineBook</display-name>

    <filter>
        <filter-name>ErrorHandlingFilter</filter-name>
        <filter-class>vn.edu.cinebook.filter.ErrorHandlingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>ErrorHandlingFilter</filter-name>
        <url-pattern>/*</url-pattern>
        <dispatcher>REQUEST</dispatcher>
    </filter-mapping>

    <filter>
        <filter-name>SecurityHeadersFilter</filter-name>
        <filter-class>vn.edu.cinebook.filter.SecurityHeadersFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>SecurityHeadersFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>RequestContextFilter</filter-name>
        <filter-class>vn.edu.cinebook.filter.RequestContextFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RequestContextFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CsrfFilter</filter-name>
        <filter-class>vn.edu.cinebook.filter.CsrfFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>vn.edu.cinebook.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/booking/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/api/seat-holds</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/checkout</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/payments/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/profile/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/tickets/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminFilter</filter-name>
        <filter-class>vn.edu.cinebook.filter.AdminFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- Servlets Configuration -->
    <servlet>
        <servlet-name>AdminBannerServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.AdminBannerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminBannerServlet</servlet-name>
        <url-pattern>/admin/banners</url-pattern>
        <url-pattern>/admin/banners/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminMovieServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.AdminMovieServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminMovieServlet</servlet-name>
        <url-pattern>/admin/movies</url-pattern>
        <url-pattern>/admin/movies/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/admin/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BookingHistoryServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.BookingHistoryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BookingHistoryServlet</servlet-name>
        <url-pattern>/profile/bookings</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CheckoutServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.CheckoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckoutServlet</servlet-name>
        <url-pattern>/checkout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CinemaServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.CinemaServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CinemaServlet</servlet-name>
        <url-pattern>/cinemas</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ComboServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.ComboServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ComboServlet</servlet-name>
        <url-pattern>/booking/combos</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/auth/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/auth/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MovieServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.MovieServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MovieServlet</servlet-name>
        <url-pattern>/movies</url-pattern>
        <url-pattern>/movies/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PaymentServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.PaymentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PaymentServlet</servlet-name>
        <url-pattern>/payments/simulate</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileScaffoldServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.ProfileScaffoldServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileScaffoldServlet</servlet-name>
        <url-pattern>/profile/watchlist</url-pattern>
        <url-pattern>/profile/reviews</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
        <url-pattern>/auth/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SeatHoldApiServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.SeatHoldApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SeatHoldApiServlet</servlet-name>
        <url-pattern>/api/seat-holds</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SeatServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.SeatServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SeatServlet</servlet-name>
        <url-pattern>/booking/seats</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ShowtimeServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.ShowtimeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ShowtimeServlet</servlet-name>
        <url-pattern>/booking/showtimes</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>TicketServlet</servlet-name>
        <servlet-class>vn.edu.cinebook.controller.TicketServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>TicketServlet</servlet-name>
        <url-pattern>/tickets</url-pattern>
        <url-pattern>/tickets/*</url-pattern>
    </servlet-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/errors/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/errors/500.jsp</location>
    </error-page>
</web-app>
