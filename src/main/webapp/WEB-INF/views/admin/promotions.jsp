<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="cb" uri="/WEB-INF/cinebook.tld" %>
<jsp:include page="/WEB-INF/views/shared/header.jsp"><jsp:param name="title" value="Promotion Management"/><jsp:param name="active" value="admin"/></jsp:include>
<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-7 lg:grid-cols-[220px_1fr]">
        <jsp:include page="/WEB-INF/views/admin/sidebar.jsp"><jsp:param name="section" value="promotions"/></jsp:include>
        <div class="min-w-0 space-y-8">
            <div><p class="text-sm font-black uppercase tracking-[.25em] text-rose-500">Administration</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">Promotion Management</h1><p class="mt-2 max-w-2xl text-zinc-500">Create discount codes by percent or fixed amount with validity windows and minimum order rules.</p></div>
            <c:if test="${not empty flashMessage}"><div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm font-semibold text-emerald-400"><c:out value="${flashMessage}"/></div></c:if>
            <c:if test="${not empty error}"><div class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-sm font-semibold text-rose-400"><c:out value="${error}"/></div></c:if>
            <form method="post" action="<c:url value='/admin/promotions'/>" class="rounded-2xl border border-white/10 bg-white/[.025] p-6 shadow-xl">
                <input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><c:if test="${not empty promotion}"><input type="hidden" name="id" value="<c:out value='${promotion.id}'/>"></c:if>
                <div class="grid gap-5 lg:grid-cols-4">
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Code</label><input name="code" value="<c:out value='${promotion.code}'/>" required maxlength="40" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div class="lg:col-span-2"><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Name</label><input name="name" value="<c:out value='${promotion.name}'/>" required maxlength="150" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Type</label><select name="discountType" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"><option value="PERCENT" ${empty promotion || promotion.discountType == 'PERCENT' ? 'selected' : ''} class="bg-zinc-900">Percent</option><option value="FIXED" ${not empty promotion && promotion.discountType == 'FIXED' ? 'selected' : ''} class="bg-zinc-900">Fixed amount</option></select></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Discount Value</label><input type="number" name="discountValue" value="<c:out value='${not empty promotion ? promotion.discountValue : 10}'/>" min="1" step="1" required class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Minimum Order</label><input type="number" name="minimumOrder" value="<c:out value='${not empty promotion ? promotion.minimumOrder : 0}'/>" min="0" step="1000" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Max Discount</label><input type="number" name="maximumDiscount" value="<c:out value='${promotion.maximumDiscount}'/>" min="0" step="1000" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Usage Limit</label><input type="number" name="usageLimit" value="<c:out value='${promotion.usageLimit}'/>" min="1" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Per User Limit</label><input type="number" name="perUserLimit" value="<c:out value='${promotion.perUserLimit}'/>" min="1" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Starts At</label><input type="datetime-local" name="startsAt" value="<c:out value='${not empty promotion ? cb:htmlDateTime(promotion.startsAt) : ""}'/>" required class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Ends At</label><input type="datetime-local" name="endsAt" value="<c:out value='${not empty promotion ? cb:htmlDateTime(promotion.expiresAt) : ""}'/>" required class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div class="lg:col-span-2"><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Description</label><input name="description" value="<c:out value='${promotion.description}'/>" maxlength="500" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <label class="flex items-end gap-3 pb-3 text-sm font-bold text-white"><input type="checkbox" name="active" ${empty promotion || promotion.active ? 'checked' : ''} class="h-5 w-5 rounded border-white/20 bg-black/40 text-rose-600"> Active</label>
                </div>
                <div class="mt-6 flex justify-end gap-3 border-t border-white/10 pt-5"><a href="<c:url value='/admin/promotions'/>" class="rounded-xl border border-white/10 px-5 py-3 text-sm font-bold text-zinc-300 hover:bg-white/5">Reset</a><button class="rounded-xl bg-rose-600 px-6 py-3 text-sm font-black text-white hover:bg-rose-500">${not empty promotion ? 'Update Promotion' : 'Create Promotion'}</button></div>
            </form>
            <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/[.025] shadow-xl"><div class="border-b border-white/10 p-4 text-sm font-bold text-white">Promotion Codes</div><div class="overflow-x-auto"><table class="w-full min-w-[950px] text-left text-sm"><thead class="bg-black/40 text-xs uppercase tracking-wider text-zinc-400"><tr><th class="px-5 py-4">Code</th><th class="px-5 py-4">Discount</th><th class="px-5 py-4">Minimum</th><th class="px-5 py-4">Window</th><th class="px-5 py-4">Used</th><th class="px-5 py-4">Status</th><th class="px-5 py-4 text-right">Actions</th></tr></thead><tbody class="divide-y divide-white/5"><c:forEach var="p" items="${items}"><tr class="hover:bg-white/[.025]"><td class="px-5 py-4"><div class="font-bold text-white"><c:out value="${p.code}"/></div><div class="text-xs text-zinc-500"><c:out value="${p.name}"/></div></td><td class="px-5 py-4 text-zinc-300"><c:out value="${p.discountType}"/> <c:out value="${p.discountValue}"/></td><td class="px-5 py-4 text-zinc-300"><c:out value="${cb:money(p.minimumOrder)}"/></td><td class="px-5 py-4 text-zinc-300"><c:out value="${cb:dateTime(p.startsAt)}"/> to <c:out value="${cb:dateTime(p.expiresAt)}"/></td><td class="px-5 py-4 text-zinc-300"><c:out value="${p.timesRedeemed}"/></td><td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-bold ${p.active ? 'bg-emerald-500/20 text-emerald-400' : 'bg-zinc-500/20 text-zinc-400'}"><c:out value="${p.active ? 'ACTIVE' : 'INACTIVE'}"/></span></td><td class="px-5 py-4 text-right"><a href="<c:url value='/admin/promotions?action=edit&id=${p.id}'/>" class="font-bold text-sky-400 hover:text-sky-300">Edit</a><form method="post" action="<c:url value='/admin/promotions'/>" class="ml-3 inline" onsubmit="return confirm('Disable this promotion?');"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="_method" value="DELETE"><input type="hidden" name="id" value="<c:out value='${p.id}'/>"><button class="font-bold text-rose-400 hover:text-rose-300">Delete</button></form></td></tr></c:forEach></tbody></table></div></div>
        </div>
    </div>
</section>
<jsp:include page="/WEB-INF/views/shared/footer.jsp"/>
