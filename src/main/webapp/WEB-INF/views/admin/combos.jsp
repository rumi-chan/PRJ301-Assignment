<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="cb" uri="/WEB-INF/cinebook.tld" %>
<jsp:include page="/WEB-INF/views/shared/header.jsp"><jsp:param name="title" value="Combo Management"/><jsp:param name="active" value="admin"/></jsp:include>
<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid gap-7 lg:grid-cols-[220px_1fr]">
        <jsp:include page="/WEB-INF/views/admin/sidebar.jsp"><jsp:param name="section" value="combos"/></jsp:include>
        <div class="min-w-0 space-y-8">
            <div><p class="text-sm font-black uppercase tracking-[.25em] text-rose-500">Administration</p><h1 class="mt-2 text-3xl font-black sm:text-4xl">Combo Management</h1><p class="mt-2 max-w-2xl text-zinc-500">Add, update, disable, and sort popcorn or drink combos shown during booking.</p></div>
            <c:if test="${not empty flashMessage}"><div class="rounded-xl border border-emerald-500/20 bg-emerald-500/10 p-4 text-sm font-semibold text-emerald-400"><c:out value="${flashMessage}"/></div></c:if>
            <c:if test="${not empty error}"><div class="rounded-xl border border-rose-500/20 bg-rose-500/10 p-4 text-sm font-semibold text-rose-400"><c:out value="${error}"/></div></c:if>
            <form method="post" action="<c:url value='/admin/combos'/>" class="rounded-2xl border border-white/10 bg-white/[.025] p-6 shadow-xl">
                <input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><c:if test="${not empty combo}"><input type="hidden" name="id" value="<c:out value='${combo.id}'/>"></c:if>
                <div class="grid gap-5 lg:grid-cols-4">
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">SKU</label><input name="sku" value="<c:out value='${combo.sku}'/>" required maxlength="40" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div class="lg:col-span-2"><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Name</label><input name="name" value="<c:out value='${combo.name}'/>" required maxlength="150" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Price</label><input type="number" name="price" value="<c:out value='${not empty combo ? combo.price : 75000}'/>" min="0" step="1000" required class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div class="lg:col-span-2"><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Description</label><input name="description" value="<c:out value='${combo.description}'/>" maxlength="500" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Image URL</label><input name="imageUrl" value="<c:out value='${combo.imageUrl}'/>" class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <div><label class="block text-xs font-bold uppercase tracking-wider text-zinc-400">Display Order</label><input type="number" name="displayOrder" value="<c:out value='${not empty combo ? combo.displayOrder : 1}'/>" min="1" required class="mt-2 w-full rounded-xl border border-white/10 bg-black/40 px-4 py-3 text-sm text-white"></div>
                    <label class="flex items-end gap-3 pb-3 text-sm font-bold text-white"><input type="checkbox" name="active" ${empty combo || combo.active ? 'checked' : ''} class="h-5 w-5 rounded border-white/20 bg-black/40 text-rose-600"> Active</label>
                </div>
                <div class="mt-6 flex justify-end gap-3 border-t border-white/10 pt-5"><a href="<c:url value='/admin/combos'/>" class="rounded-xl border border-white/10 px-5 py-3 text-sm font-bold text-zinc-300 hover:bg-white/5">Reset</a><button class="rounded-xl bg-rose-600 px-6 py-3 text-sm font-black text-white hover:bg-rose-500">${not empty combo ? 'Update Combo' : 'Create Combo'}</button></div>
            </form>
            <div class="overflow-hidden rounded-2xl border border-white/10 bg-white/[.025] shadow-xl"><div class="border-b border-white/10 p-4 text-sm font-bold text-white">Combo Catalog</div><div class="overflow-x-auto"><table class="w-full min-w-[800px] text-left text-sm"><thead class="bg-black/40 text-xs uppercase tracking-wider text-zinc-400"><tr><th class="px-5 py-4">Combo</th><th class="px-5 py-4">SKU</th><th class="px-5 py-4">Price</th><th class="px-5 py-4">Order</th><th class="px-5 py-4">Status</th><th class="px-5 py-4 text-right">Actions</th></tr></thead><tbody class="divide-y divide-white/5"><c:forEach var="cbo" items="${items}"><tr class="hover:bg-white/[.025]"><td class="px-5 py-4"><div class="font-bold text-white"><c:out value="${cbo.name}"/></div><div class="text-xs text-zinc-500"><c:out value="${cbo.description}"/></div></td><td class="px-5 py-4 text-zinc-300"><c:out value="${cbo.sku}"/></td><td class="px-5 py-4 text-zinc-300"><c:out value="${cb:money(cbo.price)}"/></td><td class="px-5 py-4 text-zinc-300">#<c:out value="${cbo.displayOrder}"/></td><td class="px-5 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-bold ${cbo.active ? 'bg-emerald-500/20 text-emerald-400' : 'bg-zinc-500/20 text-zinc-400'}"><c:out value="${cbo.active ? 'ACTIVE' : 'INACTIVE'}"/></span></td><td class="px-5 py-4 text-right"><a href="<c:url value='/admin/combos?action=edit&id=${cbo.id}'/>" class="font-bold text-sky-400 hover:text-sky-300">Edit</a><form method="post" action="<c:url value='/admin/combos'/>" class="ml-3 inline" onsubmit="return confirm('Disable this combo?');"><input type="hidden" name="_csrf" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="_method" value="DELETE"><input type="hidden" name="id" value="<c:out value='${cbo.id}'/>"><button class="font-bold text-rose-400 hover:text-rose-300">Delete</button></form></td></tr></c:forEach></tbody></table></div></div>
        </div>
    </div>
</section>
<jsp:include page="/WEB-INF/views/shared/footer.jsp"/>
